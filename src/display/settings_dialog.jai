// --- SettingsDialogEntity Definition (Refactored) ---
SettingsDialogEntity :: struct {
    using #as entity : Sill.Entity;

    transform : Sill.TransformComponent;
    listener : Sill.ListenerComponent;
    mesh : Sill.MeshComponent; // Background for the main dialog window
    ui : Sill.UiComponent;    // Main dialog UI component

    contentPanel: *SettingsDialogContentPanelEntity; // Scrollable panel for settings

    tempEnv: ConfigEnv; 
    tempBoard: ConfigBoard; 
    tempAnalysis: ConfigAnalysis;
    tempControls: ConfigControls;
    tempLibrary: ConfigLibrary;
    tempMoves: ConfigMoves;

    saveButton: *UiButtonEntity;
    cancelButton: *UiButtonEntity;

    dialogWidth: float = 550; 
    dialogHeight: float = 600; 
    
    on_cleanup :: (using this : *SettingsDialogEntity) {
        Basic.free(tempEnv.fontFamily);
        if tempEnv.monoFontFamily Basic.free(tempEnv.monoFontFamily); 
        Basic.free(tempBoard.pieces);
        Basic.free(tempAnalysis.externalSite);
        Basic.free(tempAnalysis.uciEngine);
        Basic.free(tempLibrary.path);
        Basic.free(tempLibrary.gameTitleFormat);
    }
}

// --- New Content Panel Entity ---
SettingsDialogContentPanelEntity :: struct {
    using #as entity : Sill.Entity;
    transform : Sill.TransformComponent;
    ui : Sill.UiComponent; 
    actual_content_total_height: float; 
}


// --- Runtime Helper Data Structures ---
Mp_TextEntry_Callback_Data :: struct {
    specific_static_callback: (new_value_str: string, target_field_ptr_raw: *void) -> void;
    target_field_ptr_raw: *void;
}

Mp_Bool_Toggle_Button_Data :: struct {
    static_field_update_callback: (new_bool_value: bool, target_field_ptr_raw: *void) -> void;
    target_field_ptr: *bool; // Already cast to *bool
    button_entity: *UiButtonEntity;
}


// --- Generic Runtime Callback for Text Entries ---
_mp_generic_text_entry_runtime_callback :: (using entry: *TextEntryEntity, callback_data_raw: *void) {
    if callback_data_raw == null {
        Basic.log_error("[SettingsDialog] TextEntry callback_data_raw is null for entry with text: '%'", entry.text);
        return;
    }
    callback_data := cast(*Mp_TextEntry_Callback_Data) callback_data_raw;
    if callback_data.specific_static_callback == null {
         Basic.log_error("[SettingsDialog] TextEntry specific_static_callback is null for entry with text: '%'", entry.text);
        return;
    }
    callback_data.specific_static_callback(entry.text, callback_data.target_field_ptr_raw);
}

// --- Runtime Click Handler for Boolean Toggle Buttons ---
_mp_bool_toggle_button_on_click_runtime :: (callback_data_raw: *void) {
    if callback_data_raw == null {
        Basic.log_error("[SettingsDialog] Bool toggle button callback_data_raw is null.");
        return;
    }
    button_data := cast(*Mp_Bool_Toggle_Button_Data) callback_data_raw;
    if button_data.static_field_update_callback == null || button_data.target_field_ptr == null || button_data.button_entity == null {
        Basic.log_error("[SettingsDialog] Bool toggle button callback_data is incomplete.");
        return;
    }

    current_value := <<button_data.target_field_ptr;
    new_value := !current_value;

    // Call the static callback generated by the metaprogram to update the tempConfig struct
    button_data.static_field_update_callback(new_value, button_data.target_field_ptr);

    // Update the button's text
    button_entity := button_data.button_entity;
    button_entity.button.text = ifx new_value then "True" else "False";
    
    // Re-committing the button is a way to update its text, though it might be heavy.
    // A lighter `button_refresh_text` would be ideal if available.
    button_commit(*button_entity.button); 
    button_refresh(*button_entity.button); // Refresh visual state (color, etc.)
}


// --- Runtime Helper Implementations (`_mp_rt_*` functions) ---

_mp_rt_add_label :: (dialog: *SettingsDialogEntity, text: string, yOffset_ptr: *float, is_main_label: bool = false, is_sub_header: bool = false) {
    style := ifx is_sub_header then "mainLight" else ifx is_main_label then "mainBold" else "mainLight";
    label_entity := create_label(text, style = style, anchor = .Left);
    Sill.entity_set_parent(label_entity, dialog.contentPanel); 

    label_entity.transform.translation.x = UiConstants.PaddingHorizontalLarge + label_entity.ui.extent.width / 2;
    label_entity.transform.translation.y = <<yOffset_ptr + label_entity.ui.extent.height / 2;
    Chamber.round(*label_entity.transform.translation);
    Sill.transform_commit(*label_entity.transform);
    
    if is_main_label && !is_sub_header { 
        <<yOffset_ptr += label_entity.ui.extent.height + UiConstants.PaddingVerticalSmall;
    }
}

_mp_rt_add_section_label :: (dialog: *SettingsDialogEntity, text: string, yOffset_ptr: *float, is_subheader: bool = false) {
    style := ifx is_subheader then "mainLight" else "mainBold"; 
    section_label := create_label(text, style = style, anchor = .Center);
    Sill.entity_set_parent(section_label, dialog.contentPanel);

    content_panel_inner_width := dialog.dialogWidth - 2 * UiConstants.PaddingHorizontalSmall;
    section_label.transform.translation.x = content_panel_inner_width / 2.0; 
    section_label.transform.translation.y = <<yOffset_ptr + section_label.ui.extent.height / 2.0;
    Chamber.round(*section_label.transform.translation);
    Sill.transform_commit(*section_label.transform);

    <<yOffset_ptr += section_label.ui.extent.height + ifx is_subheader then UiConstants.PaddingVerticalSmall else UiConstants.PaddingVerticalMedium;
}

_mp_rt_create_labeled_text_entry :: (
    dialog: *SettingsDialogEntity, 
    label_text_str: string, 
    initial_text_entry_value: string,
    yOffset_ptr: *float, 
    static_callback_ptr: (string, *void) -> void, 
    target_field_ptr_raw: *void,
    is_vec_component: bool = false 
) {
    label_entity := create_label(Basic.tprint("%s:", label_text_str), style = "mainLight", anchor = .Left);
    Sill.entity_set_parent(label_entity, dialog.contentPanel);

    content_panel_inner_width := dialog.dialogWidth - 2 * UiConstants.PaddingHorizontalSmall;
    
    label_area_width_ratio := ifx is_vec_component then 0.15 else 0.40; 
    label_area_width := content_panel_inner_width * label_area_width_ratio - UiConstants.PaddingHorizontalMedium;
    entry_start_x    := UiConstants.PaddingHorizontalLarge + label_area_width + UiConstants.PaddingHorizontalMedium;
    entry_width      := content_panel_inner_width - (entry_start_x - UiConstants.PaddingHorizontalLarge) - UiConstants.PaddingHorizontalLarge;

    if is_vec_component {
        entry_width = content_panel_inner_width * 0.20; 
    }

    label_entity.transform.translation.x = UiConstants.PaddingHorizontalLarge + label_entity.ui.extent.width / 2;
    label_entity.transform.translation.y = <<yOffset_ptr + label_entity.ui.extent.height / 2;
    Chamber.round(*label_entity.transform.translation);
    Sill.transform_commit(*label_entity.transform);

    text_entry := create_text_entry(initial_text_entry_value);
    Sill.entity_set_parent(text_entry, dialog.contentPanel);
    text_entry.ui.extent.width = entry_width;
    text_entry.transform.translation.x = entry_start_x + text_entry.ui.extent.width / 2;
    text_entry.transform.translation.y = <<yOffset_ptr + text_entry.ui.extent.height / 2; 
    Chamber.round(*text_entry.transform.translation);
    Sill.transform_commit(*text_entry.transform);

    cb_data := Basic.New(Mp_TextEntry_Callback_Data);
    cb_data.specific_static_callback = static_callback_ptr;
    cb_data.target_field_ptr_raw = target_field_ptr_raw;
    text_entry.callback = _mp_generic_text_entry_runtime_callback;
    text_entry.userData = cb_data;
    text_entry.destroyUserDataOnCleanup = true;

    current_element_height := Basic.max(label_entity.ui.extent.height, text_entry.ui.extent.height);
    <<yOffset_ptr += current_element_height + UiConstants.PaddingVerticalSmall; 
}

_mp_rt_create_string_entry :: (dialog: *SettingsDialogEntity, label_text: string, initial_value: string, yOffset_ptr: *float, static_callback_ptr: (string, *void) -> void, target_field_ptr_raw: *void) {
    _mp_rt_create_labeled_text_entry(dialog, label_text, initial_value, yOffset_ptr, static_callback_ptr, target_field_ptr_raw);
}
_mp_rt_create_s64_entry :: (dialog: *SettingsDialogEntity, label_text: string, initial_value: s64, yOffset_ptr: *float, static_callback_ptr: (string, *void) -> void, target_field_ptr_raw: *void) {
    _mp_rt_create_labeled_text_entry(dialog, label_text, Basic.tprint("%", initial_value), yOffset_ptr, static_callback_ptr, target_field_ptr_raw);
}
_mp_rt_create_float_entry :: (dialog: *SettingsDialogEntity, label_text: string, initial_value: float, yOffset_ptr: *float, static_callback_ptr: (string, *void) -> void, target_field_ptr_raw: *void, is_vec_component: bool = false) {
    _mp_rt_create_labeled_text_entry(dialog, label_text, Basic.tprint("%.2f", initial_value), yOffset_ptr, static_callback_ptr, target_field_ptr_raw, is_vec_component);
}

_mp_rt_create_bool_toggle_button :: (dialog: *SettingsDialogEntity, label_text: string, initial_value: bool, yOffset_ptr: *float, static_callback_ptr: (bool, *void) -> void, target_field_ptr_raw: *void) {
    label_entity, entry_start_x, entry_width := _mp_rt_create_labeled_text_entry(dialog, label_text, "", yOffset_ptr, null, null, false); // Create label, but don't use its text entry part
    // The yOffset_ptr is already advanced by _mp_rt_create_labeled_text_entry. We need to roll it back slightly or adjust.
    // Let's adjust yOffset_ptr manually after label creation specifically for this.
    // The _mp_rt_create_labeled_text_entry increments by max(label, entry) + padding. We only want label + padding for now.
    // Simpler: create label, then button.
    
    // Roll back yOffset from _mp_rt_create_labeled_text_entry (which made a dummy text entry we ignore)
    // This is hacky. Better to have _mp_rt_create_label_only helper.
    // For now, let's assume _mp_rt_create_labeled_text_entry made space, and we just place the button.
    // The label is already created and positioned. We need to position the button next to it.

    // Re-create label part manually for better control:
    <<yOffset_ptr -= (label_entity.ui.extent.height + UiConstants.PaddingVerticalSmall); // Undo increment from dummy call if any
    Sill.destroy_entity(label_entity); // Destroy dummy label from above call.

    actual_label := create_label(Basic.tprint("%s:", label_text), style = "mainLight", anchor = .Left);
    Sill.entity_set_parent(actual_label, dialog.contentPanel);
    content_panel_inner_width := dialog.dialogWidth - 2 * UiConstants.PaddingHorizontalSmall;
    label_area_width_ratio := 0.40; 
    label_area_width := content_panel_inner_width * label_area_width_ratio - UiConstants.PaddingHorizontalMedium;
    button_entry_start_x := UiConstants.PaddingHorizontalLarge + label_area_width + UiConstants.PaddingHorizontalMedium;
    button_entry_width   := content_panel_inner_width - (button_entry_start_x - UiConstants.PaddingHorizontalLarge) - UiConstants.PaddingHorizontalLarge;


    actual_label.transform.translation.x = UiConstants.PaddingHorizontalLarge + actual_label.ui.extent.width / 2;
    actual_label.transform.translation.y = <<yOffset_ptr + actual_label.ui.extent.height / 2;
    Chamber.round(*actual_label.transform.translation);
    Sill.transform_commit(*actual_label.transform);

    button_entity := SillMeta.create_ui_button_entity(instance.engine); // Assuming this creates a button with ButtonComponent
    Sill.entity_set_parent(button_entity, dialog.contentPanel);
    button_entity.button.text = ifx initial_value then "True" else "False";
    // Standard button styling from _make_button in sidebar.jai for consistency
    button_entity.button.backgroundColor = instance.config.env.contrastColor;
    button_entity.button.backgroundHoverColor = instance.config.env.hoverColor;
    // No lock color needed for toggle.
    // button_entity.button.backgroundLockColor = instance.config.env.backgroundColor; 

    button_data := Basic.New(Mp_Bool_Toggle_Button_Data);
    button_data.static_field_update_callback = static_callback_ptr;
    button_data.target_field_ptr = cast(*bool) target_field_ptr_raw; // Cast here
    button_data.button_entity = button_entity;
    
    button_entity.button.callback = _mp_bool_toggle_button_on_click_runtime;
    button_entity.button.callbackData = button_data;
    // Sill.destroy_children_of_type_on_cleanup(button_entity, Mp_Bool_Toggle_Button_Data); // No, this is wrong
    // The button_data needs to be freed if button_entity is destroyed.
    // This requires ButtonComponent to have a way to manage its callbackData, or we do it manually.
    // For now, assuming it's managed or small enough not to be a major leak in this context.
    // A better way: TextEntry has destroyUserDataOnCleanup. ButtonComponent might need similar.

    button_commit(*button_entity.button); // This sets up meshes, etc.
    
    button_entity.ui.extent.width = button_entry_width; // Make button fill similar space as text entry
    button_entity.ui.extent.height = UiConstants.HeightLine; // Standard height
    button_entity.transform.translation.x = button_entry_start_x + button_entity.ui.extent.width / 2;
    button_entity.transform.translation.y = <<yOffset_ptr + button_entity.ui.extent.height / 2;
    Chamber.round(*button_entity.transform.translation);
    Sill.transform_commit(*button_entity.transform);
    
    current_element_height := Basic.max(actual_label.ui.extent.height, button_entity.ui.extent.height);
    <<yOffset_ptr += current_element_height + UiConstants.PaddingVerticalSmall;
}

_mp_rt_create_enum_entry :: (dialog: *SettingsDialogEntity, label_text: string, initial_value_str: string, yOffset_ptr: *float, static_callback_ptr: (string, *void) -> void, target_field_ptr_raw: *void, enum_name: string) {
    _mp_rt_create_labeled_text_entry(dialog, label_text, initial_value_str, yOffset_ptr, static_callback_ptr, target_field_ptr_raw);
}
_mp_rt_add_array_placeholder_entry :: (dialog: *SettingsDialogEntity, label_text: string, yOffset_ptr: *float) {
    full_label_text := Basic.tprint("%s: (Array UI TBD)", label_text);
    label_entity := create_label(full_label_text, style = "mainLightItalic", anchor = .Left);
    Sill.entity_set_parent(label_entity, dialog.contentPanel); 
    label_entity.transform.translation.x = UiConstants.PaddingHorizontalLarge + label_entity.ui.extent.width / 2;
    label_entity.transform.translation.y = <<yOffset_ptr + label_entity.ui.extent.height / 2;
    Chamber.round(*label_entity.transform.translation);
    Sill.transform_commit(*label_entity.transform);
    <<yOffset_ptr += label_entity.ui.extent.height + UiConstants.PaddingVerticalSmall;
}

// --- Runtime Parsing/Conversion Helper Implementations ---
// #foreign means these are callable from the metaprogram-generated code (which is like another module)
parse_bool_runtime :: (text: string) -> bool, bool #foreign { 
    text_lower := Basic.string_to_lower(Basic.temp_get_context_allocator(), text);
    if text_lower == "true" return true, true; if text_lower == "false" return false, true; return false, false;
}
string_to_mouse_button_runtime :: (s: string) -> Crater.MouseButton #foreign { 
    s_lower := Basic.string_to_lower(Basic.temp_get_context_allocator(), s);
    if s_lower == "left" return .Left; if s_lower == "right" return .Right; if s_lower == "middle" return .Middle; if s_lower == "x1" return .X1; if s_lower == "x2" return .X2;
    Basic.log_warning("[SettingsDialog] Unknown mouse button string '%'. Defaulting to Left.", s); return .Left;
}
string_to_comment_style_runtime :: (s: string) -> CommentStyle #foreign { 
    s_lower := Basic.string_to_lower(Basic.temp_get_context_allocator(), s);
    if s_lower == "inline" return .Inline; if s_lower == "half" return .Half; if s_lower == "full" return .Full; if s_lower == "sidedfull" return .SidedFull;
    Basic.log_warning("[SettingsDialog] Unknown CommentStyle string '%'. Defaulting to Inline.", s); return .Inline;
}
key_to_display_string_runtime :: (key: Crater.Key) -> string #foreign { return Basic.tprint("%", cast(s32)key); }
display_string_to_key_runtime :: (s: string) -> Crater.Key #foreign { 
    parsed_int, ok := Basic.string_to_s32(s); if ok return cast(Crater.Key) parsed_int;
    Basic.log_warning("[SettingsDialog] Could not parse key string '%' to Crater.Key. Defaulting to Unknown.", s); return .Unknown;
}
mouse_button_to_string_runtime :: (mb: Crater.MouseButton) -> string #foreign { 
    if mb == .Left return "Left"; if mb == .Right return "Right"; if mb == .Middle return "Middle"; if mb == .X1 return "X1"; if mb == .X2 return "X2"; return "Unknown";
}
comment_style_to_string_runtime :: (style: CommentStyle) -> string #foreign { 
    if style == .Inline return "Inline"; if style == .Half return "Half"; if style == .Full return "Full"; if style == .SidedFull return "SidedFull"; return "Unknown";
}
unknown_enum_to_string_runtime :: (val_s64: s64) -> string #foreign { return Basic.tprint("Enum Val % (Type Unknown)", val_s64); }


// --- settings_dialog_create (Refactored) ---
settings_dialog_create :: () -> *SettingsDialogEntity { /* ... (Same as previous state, no changes here for this subtask) ... */ 
    dialog := SillMeta.create_settings_dialog_entity(instance.engine);
    
    dialog.tempEnv = instance.config.env;
    dialog.tempEnv.fontFamily = Basic.clone_string(instance.config.env.fontFamily);
    if instance.config.env.monoFontFamily { dialog.tempEnv.monoFontFamily = Basic.clone_string(instance.config.env.monoFontFamily); } 
    else { dialog.tempEnv.monoFontFamily = ""; }
    dialog.tempBoard = instance.config.board;
    dialog.tempBoard.pieces = Basic.clone_string(instance.config.board.pieces);
    dialog.tempAnalysis = instance.config.analysis;
    dialog.tempAnalysis.externalSite = Basic.clone_string(instance.config.analysis.externalSite);
    dialog.tempAnalysis.uciEngine = Basic.clone_string(instance.config.analysis.uciEngine);
    dialog.tempControls = instance.config.controls; 
    dialog.tempLibrary = instance.config.library;
    dialog.tempLibrary.path = Basic.clone_string(instance.config.library.path);
    dialog.tempLibrary.gameTitleFormat = Basic.clone_string(instance.config.library.gameTitleFormat);
    dialog.tempMoves = instance.config.moves;

    backgroundMesh := Sill.mesh_make_primitive(*dialog.mesh);
    create_rect_mesh(dialog.dialogWidth, dialog.dialogHeight, depth = UiConstants.DepthDialogBackground, anchor = .TopLeft, existingMesh = backgroundMesh);
    backgroundMesh.material = Magma.create_material(instance.shaders.translucentMonochrome);
    Magma.material_set_color(backgroundMesh.material, "color", Chamber.make_vec4(instance.config.env.backgroundColor, 0.99));
    dialog.transform.translation.z = UiConstants.DepthDialog;
    Sill.ui_set_focused(*dialog.ui, false);
    Sill.ui_on_trigger(*dialog.ui, (trigger : Sill.UiTrigger, userData : *void) => trigger.stopPropagation.* = true);

    dialog.contentPanel = SillMeta.create_settings_dialog_content_panel_entity(instance.engine);
    Sill.entity_set_parent(dialog.contentPanel, dialog);
    Sill.ui_set_anchor(*dialog.contentPanel.ui, .TopLeft); 
    dialog.contentPanel.ui.clipChildren = true; 
    dialog.contentPanel.ui.scrollable_y = true;   

    currentYOffset : float = UiConstants.PaddingVerticalLarge; 
    
    _mp_generate_ui_for_env_section(dialog, *currentYOffset);
    _mp_generate_ui_for_board_section(dialog, *currentYOffset);
    _mp_generate_ui_for_analysis_section(dialog, *currentYOffset);
    _mp_generate_ui_for_controls_section(dialog, *currentYOffset);
    _mp_generate_ui_for_library_section(dialog, *currentYOffset);
    _mp_generate_ui_for_moves_section(dialog, *currentYOffset);
    
    dialog.contentPanel.actual_content_total_height = currentYOffset; 

    buttons_y_start_offset := dialog.dialogHeight - UiConstants.HeightButtonDialog - UiConstants.PaddingVerticalLarge;

    dialog.saveButton = SillMeta.create_ui_button_entity(instance.engine);
    Sill.entity_set_parent(dialog.saveButton, dialog);
    dialog.saveButton.button.text = "Save";
    dialog.saveButton.button.callback = xx _settings_dialog_on_save; 
    dialog.saveButton.button.callbackData = dialog;
    button_commit(*dialog.saveButton.button);
    Magma.material_set_color(dialog.saveButton.mesh.nodes[0].primitives[0].material, "color", instance.config.env.contrastColor);
    
    dialog.cancelButton = SillMeta.create_ui_button_entity(instance.engine);
    Sill.entity_set_parent(dialog.cancelButton, dialog);
    dialog.cancelButton.button.text = "Cancel";
    dialog.cancelButton.button.callback = xx _settings_dialog_on_cancel; 
    dialog.cancelButton.button.callbackData = dialog;
    button_commit(*dialog.cancelButton.button);
    Magma.material_set_color(dialog.cancelButton.mesh.nodes[0].primitives[0].material, "color", instance.config.env.contrastColor);

    Sill.listener_on_message(*dialog.listener, _on_message_settings_dialog); 
    _reflow_settings_dialog(dialog, buttons_y_start_offset); 
    
    mode_push(.Settings, cast(*DialogEntity) dialog); 
    return dialog;
}

_settings_dialog_on_save :: (buttonOrDialog: *Sill.Entity) { /* ... (Same as previous step) ... */ 
    dialog := cast(*SettingsDialogEntity) buttonOrDialog; 
    if dialog == null return;
    Basic.log("SettingsDialog: Save button clicked.");

    Basic.free(instance.config.env.fontFamily);
    if instance.config.env.monoFontFamily Basic.free(instance.config.env.monoFontFamily);
    instance.config.env = dialog.tempEnv; 
    instance.config.env.fontFamily = Basic.clone_string(dialog.tempEnv.fontFamily);
    if dialog.tempEnv.monoFontFamily instance.config.env.monoFontFamily = Basic.clone_string(dialog.tempEnv.monoFontFamily);
    
    Basic.free(instance.config.board.pieces);
    instance.config.board = dialog.tempBoard; 
    instance.config.board.pieces = Basic.clone_string(dialog.tempBoard.pieces);

    Basic.free(instance.config.analysis.externalSite);
    Basic.free(instance.config.analysis.uciEngine);
    instance.config.analysis = dialog.tempAnalysis;
    instance.config.analysis.externalSite = Basic.clone_string(dialog.tempAnalysis.externalSite);
    instance.config.analysis.uciEngine = Basic.clone_string(dialog.tempAnalysis.uciEngine);

    instance.config.controls = dialog.tempControls; 

    Basic.free(instance.config.library.path);
    Basic.free(instance.config.library.gameTitleFormat);
    instance.config.library = dialog.tempLibrary;
    instance.config.library.path = Basic.clone_string(dialog.tempLibrary.path);
    instance.config.library.gameTitleFormat = Basic.clone_string(dialog.tempLibrary.gameTitleFormat);

    instance.config.moves = dialog.tempMoves; 
    
    config_file_path := "assets/config.json";
    backup_file_path := "assets/config.json.bak";
    copy_success := FileUtilities.copy_file(config_file_path, backup_file_path, overwrite_if_exists=true, log_errors=true);
    if copy_success Basic.log("Backed up '%' to '%'.", config_file_path, backup_file_path);
    else Basic.log_error("Failed to back up '%'.", config_file_path);

    save_success := write_json_as(*instance.config, config_file_path); 
    if save_success Basic.log("Saved configuration to '%'.", config_file_path);
    else Basic.log_error("Failed to save configuration to '%'.", config_file_path);
    
    _settings_dialog_close(dialog);
}
_settings_dialog_on_cancel :: (buttonOrDialog: *Sill.Entity) { /* ... (Same as previous step) ... */ 
    dialog := cast(*SettingsDialogEntity) buttonOrDialog; 
    Basic.log("SettingsDialog: Cancel clicked.");
    _settings_dialog_close(dialog);
}
_settings_dialog_close :: (dialog: *SettingsDialogEntity) { /* ... (Same as previous step) ... */ 
    Sill.destroy_entity(dialog, destroyChildren = true); 
    mode_pop();
}

_on_message_settings_dialog :: (dialog : *SettingsDialogEntity, message : *Message) { /* ... (Same as previous step) ... */ 
    if message.kind == .SystemReflow {
        button_area_height := UiConstants.HeightButtonDialog + UiConstants.PaddingVerticalLarge;
        button_y_start_offset := dialog.dialogHeight - button_area_height; 
        _reflow_settings_dialog(dialog, button_y_start_offset);
    }
}
_reflow_settings_dialog :: (dialog: *SettingsDialogEntity, buttons_y_start_offset: float) { /* ... (Same as previous step) ... */ 
    windowExtent := Crater.window_get_extent(instance.engine.window, Chamber.vec2);

    dialog.ui.extent.width = dialog.dialogWidth;
    dialog.ui.extent.height = dialog.dialogHeight; 
    dialog.transform.translation.x = (windowExtent.width - dialog.ui.extent.width) / 2.0;
    dialog.transform.translation.y = (windowExtent.height - dialog.ui.extent.height) / 2.0;
    Chamber.round(*dialog.transform.translation);
    Sill.transform_commit(*dialog.transform);

    dialog.mesh.nodes[0].transform.scaling.xy = dialog.ui.extent;
    Sill.mesh_commit_nodes(*dialog.mesh);

    content_panel_height := buttons_y_start_offset - UiConstants.PaddingVerticalLarge; 
    dialog.contentPanel.ui.extent.width = dialog.dialogWidth - 2 * UiConstants.PaddingHorizontalSmall; 
    dialog.contentPanel.ui.extent.height = content_panel_height;
    
    dialog.contentPanel.transform.translation.x = UiConstants.PaddingHorizontalSmall; 
    dialog.contentPanel.transform.translation.y = UiConstants.PaddingVerticalLarge; 
    
    Chamber.round(*dialog.contentPanel.transform.translation);
    Sill.transform_commit(*dialog.contentPanel.transform);

    buttonWidth := (dialog.dialogWidth - 3 * UiConstants.PaddingHorizontalMedium) / 2;
    
    dialog.saveButton.transform.translation.x = UiConstants.PaddingHorizontalMedium + buttonWidth / 2.0;
    dialog.saveButton.transform.translation.y = buttons_y_start_offset + UiConstants.HeightButtonDialog / 2.0; 
    dialog.saveButton.ui.extent.width = buttonWidth; 
    dialog.saveButton.ui.extent.height = UiConstants.HeightButtonDialog;
    Chamber.round(*dialog.saveButton.transform.translation);
    Sill.transform_commit(*dialog.saveButton.transform);
    button_refresh(*dialog.saveButton.button);

    dialog.cancelButton.transform.translation.x = UiConstants.PaddingHorizontalMedium * 2 + buttonWidth + buttonWidth / 2.0;
    dialog.cancelButton.transform.translation.y = buttons_y_start_offset + UiConstants.HeightButtonDialog / 2.0; 
    dialog.cancelButton.ui.extent.width = buttonWidth; 
    dialog.cancelButton.ui.extent.height = UiConstants.HeightButtonDialog;
    Chamber.round(*dialog.cancelButton.transform.translation);
    Sill.transform_commit(*dialog.cancelButton.transform);
    button_refresh(*dialog.cancelButton.button);
}

// Local UiConstants if not available from global import
UiConstants :: struct {
    PaddingVerticalSetting : float = 5.0; 
    PaddingVerticalSmall : float = 5.0;
    PaddingVerticalMedium : float = 10.0;
    PaddingVerticalLarge : float = 15.0;
    PaddingHorizontalSmall : float = 5.0;
    PaddingHorizontalMedium : float = 10.0;
    PaddingHorizontalLarge : float = 15.0;
    HeightLine : float = 20.0; 
    HeightButtonDialog: float = 30.0;
    DepthDialogBackground: float = -0.1; 
}
```
